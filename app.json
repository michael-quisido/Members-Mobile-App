{
  "expo": {
    "name": "Members Mobile App",
    "slug": "Members Mobile App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "membersmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/kmcq-gmbh-android-icon-foreground-512x512.png",
        "backgroundImage": "./assets/images/android-kmcq-gmbh-512x512.png",
        "monochromeImage": "./assets/images/android-kmcq-gmbh-512x512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040f2d",
          "image": "./assets/images/kmcq-splash-touch-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
